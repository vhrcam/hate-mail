# Encrypts saved passwords and sign-in tokens.
# Optional locally, required in production: openssl rand -base64 32
ENCRYPTION_KEY=

# Turso database. Leave empty to use a local file in data/.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Where the app runs. Sign-in redirects use it.
APP_URL=http://localhost:3000

# Sign in with Google (see README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Microsoft (see README)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
